      "name": "Планирование и проектирование",
      "status": "in_progress",
      "deliverables": [
        "PRD (этот документ)",
        "Архитектурная схема системы",
        "Схема базы данных",
        "Протоколы взаимодействия сервисов"
      ]
    },
    {
      "phase": 2,
      "name": "Разработка базовой функциональности",
      "status": "pending",
      "deliverables": [
        "Telegram Bot Service на aiogram 3.x",
        "Регистрация через /start",
        "Базовый интерфейс пользователя",
        "Интеграция с Telegram Bot API"
      ]
    },
    {
      "phase": 3,
      "name": "Система анкет и ранжирования",
      "status": "pending",
      "deliverables": [
        "CRUD для анкет",
        "Алгоритм ранжирования (3 уровня)",
        "Redis кэширование (10 анкет на сессию)",
        "Интеграция с Message Queue"
      ]
    },
    {
      "phase": 4,
      "name": "Дополнительные функции",
      "status": "pending",
      "deliverables": [
