        "Деплой"
      ]
    }
  ],
  "risks_and_mitigations": [
    {
      "risk": "Низкая активность пользователей после регистрации",
      "mitigation": "Геймификация, push-уведомления, бонусы за активность",
      "priority": "high"
    },
    {
      "risk": "Недостаточное количество анкет для подбора",
      "mitigation": "Реферальная программа, маркетинг, кросс-промо",
      "priority": "high"
    },
    {
      "risk": "Сложность настройки инфраструктуры (RabbitMQ, Redis, Celery, Minio)",
      "mitigation": "Docker Compose для локальной разработки, подробная документация",
      "priority": "medium"
    },
    {
      "risk": "Проблемы с производительностью при росте нагрузки",
      "mitigation": "Кэширование, горизонтальное масштабирование, оптимизация запросов",
      "priority": "medium"
    }
  ],
  "open_questions": [
    "Требуется ли модерация фотографий перед публикацией?",
    "Нужна ли система жалоб на пользователей?",
