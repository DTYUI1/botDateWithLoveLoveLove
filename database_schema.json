{
  "schema_info": {
    "project": "ConnectMe",
    "version": "1.0.0",
    "created_date": "2026-03-16",
    "database_type": "PostgreSQL 15+",
    "description": "Схема базы данных для dating-бота с icebreaker-вопросами"
  },
  "tables": [
    {
      "name": "users",
      "description": "Базовая сущность пользователя Telegram",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "telegram_id", "type": "BIGINT", "constraints": "UNIQUE NOT NULL"},
        {"name": "username", "type": "VARCHAR(255)", "constraints": null},
        {"name": "first_name", "type": "VARCHAR(255)", "constraints": "NOT NULL"},
        {"name": "last_name", "type": "VARCHAR(255)", "constraints": null},
        {"name": "language_code", "type": "VARCHAR(10)", "constraints": "DEFAULT 'ru'"},
        {"name": "is_bot", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_users_telegram_id", "idx_users_created_at"],
      "foreign_keys": []
    },
    {
      "name": "profiles",
      "description": "Расширенный профиль пользователя для знакомств",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "user_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES users(id)"},
        {"name": "age", "type": "INTEGER", "constraints": "CHECK (age >= 18)"},
        {"name": "gender", "type": "VARCHAR(20)", "constraints": "NOT NULL CHECK (gender IN ('male', 'female', 'other'))"},
        {"name": "bio", "type": "TEXT", "constraints": null},
        {"name": "interests", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "city", "type": "VARCHAR(100)", "constraints": null},
        {"name": "latitude", "type": "DECIMAL(9,6)", "constraints": "CHECK (latitude BETWEEN -90 AND 90)"},
        {"name": "longitude", "type": "DECIMAL(9,6)", "constraints": "CHECK (longitude BETWEEN -180 AND 180)"},
        {"name": "looking_for", "type": "VARCHAR(20)", "constraints": "NOT NULL CHECK (looking_for IN ('male', 'female', 'both'))"},
        {"name": "age_range_min", "type": "INTEGER", "constraints": "DEFAULT 18 CHECK (age_range_min >= 18)"},
        {"name": "age_range_max", "type": "INTEGER", "constraints": "DEFAULT 100 CHECK (age_range_max <= 100)"},
        {"name": "distance_max_km", "type": "INTEGER", "constraints": "DEFAULT 100 CHECK (distance_max_km >= 1)"},
        {"name": "is_active", "type": "BOOLEAN", "constraints": "DEFAULT TRUE"},
        {"name": "is_verified", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_profiles_user_id", "idx_profiles_gender_looking_for", "idx_profiles_location", "idx_profiles_age_range", "idx_profiles_interests"],
      "foreign_keys": [{"column": "user_id", "references": "users(id)"}]
    },
    {
      "name": "preferences",
      "description": "Детальные предпочтения пользователя для тонкой настройки подбора",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "preferred_cities", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "education_preference", "type": "VARCHAR(50)", "constraints": null},
        {"name": "occupation_preference", "type": "VARCHAR(50)", "constraints": null},
        {"name": "relationship_goals", "type": "VARCHAR(50)", "constraints": "CHECK (relationship_goals IN ('casual', 'serious', 'friendship', 'networking'))"},
        {"name": "deal_breakers", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "importance_weights", "type": "JSONB", "constraints": "DEFAULT '{\"age\": 0.2, \"distance\": 0.3, \"interests\": 0.5}'::jsonb"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_preferences_profile_id"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "swipes",
      "description": "История действий пользователей (лайки/пропуски)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "swiper_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "swiped_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "action", "type": "VARCHAR(10)", "constraints": "NOT NULL CHECK (action IN ('like', 'pass'))"},
        {"name": "context_data", "type": "JSONB", "constraints": "DEFAULT '{}'::jsonb"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_swipes_swiper_id", "idx_swipes_swiped_id", "idx_swipes_pair", "idx_swipes_created_at", "idx_swipes_action", "uniq_swipes_pair"],
      "foreign_keys": [
        {"column": "swiper_id", "references": "profiles(id)"},
        {"column": "swiped_id", "references": "profiles(id)"}
      ]
    },
    {
      "name": "matches",
      "description": "Взаимные лайки (мэтчи)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "user1_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "user2_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "status", "type": "VARCHAR(20)", "constraints": "DEFAULT 'active' CHECK (status IN ('active', 'archived', 'blocked'))"},
        {"name": "initiator_id", "type": "UUID", "constraints": "REFERENCES profiles(id)"},
        {"name": "last_message_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_matches_user1_id", "idx_matches_user2_id", "idx_matches_status", "idx_matches_users_combined", "idx_matches_last_message", "uniq_matches_pair"],
      "foreign_keys": [
        {"column": "user1_id", "references": "profiles(id)"},
        {"column": "user2_id", "references": "profiles(id)"},
        {"column": "initiator_id", "references": "profiles(id)"}
      ]
    },
    {
      "name": "messages",
      "description": "Сообщения в чате между мэтчами",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "match_id", "type": "UUID", "constraints": "NOT NULL REFERENCES matches(id)"},
        {"name": "sender_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "content", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "message_type", "type": "VARCHAR(20)", "constraints": "DEFAULT 'text' CHECK (message_type IN ('text', 'photo', 'icebreaker', 'voice'))"},
        {"name": "media_urls", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "is_read", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "read_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "reply_to_id", "type": "UUID", "constraints": "REFERENCES messages(id)"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_messages_match_id", "idx_messages_match_created", "idx_messages_sender_id", "idx_messages_is_read", "idx_messages_type"],
      "foreign_keys": [
        {"column": "match_id", "references": "matches(id)"},
        {"column": "sender_id", "references": "profiles(id)"},
        {"column": "reply_to_id", "references": "messages(id)"}
      ]
    },
    {
      "name": "icebreaker_questions",
      "description": "База вопросов для функции «Ледокол»",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "category", "type": "VARCHAR(30)", "constraints": "NOT NULL CHECK (category IN ('general', 'hobbies', 'travel', 'food', 'entertainment', 'deep', 'philosophical', 'funny'))"},
        {"name": "question_text", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "difficulty", "type": "VARCHAR(10)", "constraints": "DEFAULT 'light' CHECK (difficulty IN ('light', 'medium', 'deep'))"},
        {"name": "tags", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "usage_count", "type": "INTEGER", "constraints": "DEFAULT 0 CHECK (usage_count >= 0)"},
        {"name": "success_rate", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0.5 CHECK (success_rate BETWEEN 0 AND 1)"},
        {"name": "avg_response_time_sec", "type": "INTEGER", "constraints": null},
        {"name": "is_active", "type": "BOOLEAN", "constraints": "DEFAULT TRUE"},
        {"name": "created_by", "type": "UUID", "constraints": "REFERENCES users(id)"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_icebreaker_category", "idx_icebreaker_difficulty", "idx_icebreaker_tags", "idx_icebreaker_success_rate", "idx_icebreaker_usage_count"],
      "foreign_keys": [{"column": "created_by", "references": "users(id)"}]
    },
    {
      "name": "icebreaker_usage",
      "description": "История использования icebreaker-вопросов для аналитики",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "question_id", "type": "UUID", "constraints": "NOT NULL REFERENCES icebreaker_questions(id)"},
        {"name": "sender_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "recipient_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "match_id", "type": "UUID", "constraints": "NOT NULL REFERENCES matches(id)"},
        {"name": "message_id", "type": "UUID", "constraints": "REFERENCES messages(id)"},
        {"name": "was_responded", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "response_time_sec", "type": "INTEGER", "constraints": null},
        {"name": "conversation_started", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_icebreaker_usage_question", "idx_icebreaker_usage_sender", "idx_icebreaker_usage_match", "idx_icebreaker_usage_responded", "idx_icebreaker_usage_created"],
      "foreign_keys": [
        {"column": "question_id", "references": "icebreaker_questions(id)"},
        {"column": "sender_id", "references": "profiles(id)"},
        {"column": "recipient_id", "references": "profiles(id)"},
        {"column": "match_id", "references": "matches(id)"},
        {"column": "message_id", "references": "messages(id)"}
      ]
    },
    {
      "name": "ratings_primary",
      "description": "Первичный рейтинг на основе данных анкеты (completeness 30%, photo 30%, preference_match 20%, verification 20%)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "completeness_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (completeness_score BETWEEN 0 AND 1)"},
        {"name": "photo_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (photo_score BETWEEN 0 AND 1)"},
        {"name": "preference_match_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (preference_match_score BETWEEN 0 AND 1)"},
        {"name": "verification_bonus", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (verification_bonus BETWEEN 0 AND 1)"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "GENERATED ALWAYS AS (completeness_score * 0.3 + photo_score * 0.3 + preference_match_score * 0.2 + verification_bonus * 0.2) STORED"},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_primary_profile", "idx_ratings_primary_total", "idx_ratings_primary_calculated"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "ratings_behavioral",
      "description": "Поведенческий рейтинг на основе активности (like_count 25%, like_pass_ratio 25%, match_rate 20%, conversation_initiation 15%, activity_pattern 15%)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "like_count_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (like_count_score BETWEEN 0 AND 1)"},
        {"name": "like_pass_ratio_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (like_pass_ratio_score BETWEEN 0 AND 1)"},
        {"name": "match_rate_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (match_rate_score BETWEEN 0 AND 1)"},
        {"name": "conversation_initiation_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (conversation_initiation_score BETWEEN 0 AND 1)"},
        {"name": "activity_pattern_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (activity_pattern_score BETWEEN 0 AND 1)"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "GENERATED ALWAYS AS (like_count_score * 0.25 + like_pass_ratio_score * 0.25 + match_rate_score * 0.2 + conversation_initiation_score * 0.15 + activity_pattern_score * 0.15) STORED"},
        {"name": "period_start", "type": "DATE", "constraints": "NOT NULL"},
        {"name": "period_end", "type": "DATE", "constraints": "NOT NULL"},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_behavioral_profile", "idx_ratings_behavioral_total", "idx_ratings_behavioral_period", "idx_ratings_behavioral_calculated"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "ratings_combined",
      "description": "Комбинированный рейтинг: combined = (primary * 0.4) + (behavioral * 0.4) + (referral_bonus * 0.2)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "primary_score", "type": "DECIMAL(5,4)", "constraints": "NOT NULL CHECK (primary_score BETWEEN 0 AND 1)"},
        {"name": "behavioral_score", "type": "DECIMAL(5,4)", "constraints": "NOT NULL CHECK (behavioral_score BETWEEN 0 AND 1)"},
        {"name": "referral_bonus", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (referral_bonus BETWEEN 0 AND 1)"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "GENERATED ALWAYS AS (primary_score * 0.4 + behavioral_score * 0.4 + referral_bonus * 0.2) STORED"},
        {"name": "rank_position", "type": "INTEGER", "constraints": null},
        {"name": "percentile", "type": "DECIMAL(5,4)", "constraints": null},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_combined_profile", "idx_ratings_combined_total", "idx_ratings_combined_rank", "idx_ratings_combined_percentile", "idx_ratings_combined_calculated"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "referrals",
      "description": "Реферальная программа — приглашения друзей",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "referrer_id", "type": "UUID", "constraints": "NOT NULL REFERENCES users(id)"},
        {"name": "referred_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES users(id)"},
        {"name": "referral_code", "type": "VARCHAR(50)", "constraints": "UNIQUE"},
        {"name": "bonus_earned", "type": "DECIMAL(10,2)", "constraints": "DEFAULT 0"},
        {"name": "referred_user_active", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "referred_user_premium", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "activated_at", "type": "TIMESTAMPTZ", "constraints": null}
      ],
      "indexes": ["idx_referrals_referrer", "idx_referrals_referred", "idx_referrals_code", "idx_referrals_active"],
      "foreign_keys": [
        {"column": "referrer_id", "references": "users(id)"},
        {"column": "referred_id", "references": "users(id)"}
      ]
    },
    {
      "name": "sessions",
      "description": "Сессии пользователей для управления кэшированием анкет",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "user_id", "type": "UUID", "constraints": "NOT NULL REFERENCES users(id)"},
        {"name": "session_token", "type": "VARCHAR(255)", "constraints": "UNIQUE NOT NULL"},
        {"name": "redis_cache_key", "type": "VARCHAR(255)", "constraints": null},
        {"name": "cached_profiles_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "current_profile_index", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "last_profile_shown_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "is_active", "type": "BOOLEAN", "constraints": "DEFAULT TRUE"},
        {"name": "expires_at", "type": "TIMESTAMPTZ", "constraints": "NOT NULL"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_sessions_user_id", "idx_sessions_token", "idx_sessions_expires", "idx_sessions_active"],
      "foreign_keys": [{"column": "user_id", "references": "users(id)"}]
    },
    {
      "name": "metrics",
      "description": "Агрегированные метрики для аналитики",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "metric_name", "type": "VARCHAR(100)", "constraints": "NOT NULL"},
        {"name": "metric_type", "type": "VARCHAR(20)", "constraints": "NOT NULL CHECK (metric_type IN ('counter', 'gauge', 'histogram'))"},
        {"name": "metric_value", "type": "DECIMAL(20,6)", "constraints": "NOT NULL"},
        {"name": "dimensions", "type": "JSONB", "constraints": "DEFAULT '{}'::jsonb"},
        {"name": "period_start", "type": "TIMESTAMPTZ", "constraints": "NOT NULL"},
        {"name": "period_end", "type": "TIMESTAMPTZ", "constraints": "NOT NULL"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_metrics_name", "idx_metrics_period", "idx_metrics_name_period", "idx_metrics_dimensions"],
      "foreign_keys": []
    },
    {
      "name": "photos",
      "description": "Метаданные фотографий профилей (опционально)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "s3_key", "type": "VARCHAR(500)", "constraints": "NOT NULL"},
        {"name": "s3_bucket", "type": "VARCHAR(100)", "constraints": "DEFAULT 'profile-photos'"},
        {"name": "is_primary", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "order", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "file_size_bytes", "type": "BIGINT", "constraints": null},
        {"name": "mime_type", "type": "VARCHAR(50)", "constraints": "DEFAULT 'image/jpeg'"},
        {"name": "width", "type": "INTEGER", "constraints": null},
        {"name": "height", "type": "INTEGER", "constraints": null},
        {"name": "is_moderated", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "moderation_status", "type": "VARCHAR(20)", "constraints": "DEFAULT 'pending'"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_photos_profile_id", "idx_photos_primary", "idx_photos_order"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "date_ideas",
      "description": "Идеи для свиданий (опционально)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "category", "type": "VARCHAR(30)", "constraints": "NOT NULL CHECK (category IN ('cafe', 'activity', 'outdoor', 'cultural', 'entertainment'))"},
        {"name": "title", "type": "VARCHAR(200)", "constraints": "NOT NULL"},
        {"name": "description", "type": "TEXT", "constraints": null},
        {"name": "avg_cost", "type": "VARCHAR(20)", "constraints": "CHECK (avg_cost IN ('free', 'low', 'medium', 'high'))"},
        {"name": "suitable_interests", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "city", "type": "VARCHAR(100)", "constraints": null},
        {"name": "latitude", "type": "DECIMAL(9,6)", "constraints": null},
        {"name": "longitude", "type": "DECIMAL(9,6)", "constraints": null},
        {"name": "is_active", "type": "BOOLEAN", "constraints": "DEFAULT TRUE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_date_ideas_category", "idx_date_ideas_city", "idx_date_ideas_interests"],
      "foreign_keys": []
    }
  ],
  "redis_structures": [
    {
