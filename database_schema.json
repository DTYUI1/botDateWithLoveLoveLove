  "redis_structures": [
    {
      "key_pattern": "ranked_profiles:{user_id}:{session_id}",
      "type": "LIST",
      "description": "Кэш 10 отранжированных анкет на сессию",
      "ttl": 3600
    },
    {
      "key_pattern": "session:{telegram_id}",
      "type": "HASH",
      "description": "Данные сессии пользователя",
      "ttl": 3600
    },
    {
      "key_pattern": "ratelimit:{telegram_id}:{action}",
      "type": "COUNTER",
      "description": "Rate limiting для действий",
      "ttl": 60
    },
    {
      "key_pattern": "celery:*",
      "type": "VARIOUS",
      "description": "Задачи Celery",
      "ttl": null
    },
    {
      "key_pattern": "swipe_lock:{swiper_id}:{swiped_id}",
      "type": "STRING",
      "description": "Блокировка от дублирования свайпа",
      "ttl": 30
    },
    {
      "key_pattern": "match_notification:{match_id}",
      "type": "STRING",
      "description": "Флаг уведомления о мэтче",
      "ttl": 300
    },
    {
      "key_pattern": "profile_viewed:{user_id}:{profile_id}",
      "type": "STRING",
      "description": "Факт просмотра анкеты",
      "ttl": 86400
    }
  ],
  "ranking_tables": {
    "primary": {
      "table_name": "ratings_primary",
      "description": "Первичный рейтинг на основе данных анкеты",
      "factors": {
        "completeness_score": {"weight": 0.3, "description": "Полнота заполнения анкеты"},
        "photo_score": {"weight": 0.3, "description": "Количество и качество фотографий"},
        "preference_match_score": {"weight": 0.2, "description": "Соответствие предпочтениям"},
        "verification_bonus": {"weight": 0.2, "description": "Бонус за верификацию"}
      },
      "formula": "completeness_score * 0.3 + photo_score * 0.3 + preference_match_score * 0.2 + verification_bonus * 0.2",
      "recalculation": "on_profile_update"
    },
    "behavioral": {
      "table_name": "ratings_behavioral",
      "description": "Поведенческий рейтинг на основе активности",
      "factors": {
        "like_count_score": {"weight": 0.25, "description": "Количество полученных лайков"},
        "like_pass_ratio_score": {"weight": 0.25, "description": "Соотношение лайков и пропусков"},
        "match_rate_score": {"weight": 0.2, "description": "Частота мэтчей"},
        "conversation_initiation_score": {"weight": 0.15, "description": "Инициирование диалогов"},
        "response_rate_score": {"weight": 0.10, "description": "Частота ответов"},
        "activity_pattern_score": {"weight": 0.05, "description": "Паттерны активности"}
      },
      "formula": "like_count_score * 0.25 + like_pass_ratio_score * 0.25 + match_rate_score * 0.2 + conversation_initiation_score * 0.15 + response_rate_score * 0.10 + activity_pattern_score * 0.05",
      "recalculation": "daily_via_celery"
    },
    "combined": {
      "table_name": "ratings_combined",
      "description": "Комбинированный рейтинг — интеграция всех факторов",
      "factors": {
        "primary_score": {"weight": 0.40, "description": "Первичный рейтинг"},
        "behavioral_score": {"weight": 0.50, "description": "Поведенческий рейтинг"},
        "referral_bonus": {"weight": 0.10, "description": "Бонус за приглашение друзей"}
      },
      "formula": "primary_score * 0.40 + behavioral_score * 0.50 + referral_bonus * 0.10",
      "recalculation": "daily_via_celery"
    }
  }
}
