  "ranking_tables": {
    "primary": {
      "table_name": "ratings_primary",
      "description": "Первичный рейтинг на основе данных анкеты",
      "factors": {
        "completeness_score": {"weight": 0.3, "description": "Полнота заполнения анкеты"},
        "photo_score": {"weight": 0.3, "description": "Количество и качество фотографий"},
        "preference_match_score": {"weight": 0.2, "description": "Соответствие первичным предпочтениям"},
        "verification_bonus": {"weight": 0.2, "description": "Бонус за верифицированный профиль"}
      },
      "formula": "completeness_score * 0.3 + photo_score * 0.3 + preference_match_score * 0.2 + verification_bonus * 0.2",
      "recalculation": "on_profile_update"
    },
    "behavioral": {
      "table_name": "ratings_behavioral",
      "description": "Поведенческий рейтинг на основе активности",
      "factors": {
        "like_count_score": {"weight": 0.25, "description": "Количество полученных лайков"},
        "like_pass_ratio_score": {"weight": 0.25, "description": "Соотношение лайков и пропусков"},
        "match_rate_score": {"weight": 0.2, "description": "Частота взаимных лайков"},
        "conversation_initiation_score": {"weight": 0.15, "description": "Частота инициирования диалогов"},
        "activity_pattern_score": {"weight": 0.15, "description": "Временные параметры активности"}
      },
      "formula": "like_count_score * 0.25 + like_pass_ratio_score * 0.25 + match_rate_score * 0.2 + conversation_initiation_score * 0.15 + activity_pattern_score * 0.15",
      "recalculation": "daily_via_celery"
    },
    "combined": {
      "table_name": "ratings_combined",
      "description": "Комбинированный рейтинг — интеграция всех факторов",
      "factors": {
        "primary_score": {"weight": 0.4, "description": "Первичный рейтинг"},
        "behavioral_score": {"weight": 0.4, "description": "Поведенческий рейтинг"},
        "referral_bonus": {"weight": 0.2, "description": "Бонус за приглашение друзей"}
      },
      "formula": "primary_score * 0.4 + behavioral_score * 0.4 + referral_bonus * 0.2",
      "recalculation": "daily_via_celery"
    }
  },
