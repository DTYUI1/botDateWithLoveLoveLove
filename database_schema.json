{
  "schema_info": {
    "project": "ConnectMe",
    "version": "2.0.0",
    "created_date": "2026-03-16",
    "database_type": "PostgreSQL 15+",
    "description": "Схема базы данных для dating-бота (улучшенная)"
  },
  "enums": [
    {
      "name": "gender_enum",
      "values": ["male", "female", "other"]
    },
    {
      "name": "looking_for_enum",
      "values": ["male", "female", "both"]
    },
    {
      "name": "relationship_goal_enum",
      "values": ["casual", "serious", "friendship", "networking"]
    },
    {
      "name": "swipe_action_enum",
      "values": ["like", "pass", "super_like"]
    },
    {
      "name": "match_status_enum",
      "values": ["active", "archived", "blocked", "unmatched"]
    },
    {
      "name": "moderation_status_enum",
      "values": ["pending", "approved", "rejected", "under_review"]
    },
    {
      "name": "metric_type_enum",
      "values": ["counter", "gauge", "histogram"]
    },
    {
      "name": "date_category_enum",
      "values": ["cafe", "activity", "outdoor", "cultural", "entertainment"]
    },
    {
      "name": "cost_level_enum",
      "values": ["free", "low", "medium", "high"]
    },
    {
      "name": "report_reason_enum",
      "values": ["spam", "fake_profile", "harassment", "inappropriate_content", "underage", "other"]
    },
    {
      "name": "report_status_enum",
      "values": ["open", "investigating", "resolved", "dismissed"]
    },
    {
      "name": "block_reason_enum",
      "values": ["manual", "report", "system"]
    }
  ],
  "tables": [
    {
      "name": "users",
      "description": "Базовая сущность пользователя Telegram",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "telegram_id", "type": "BIGINT", "constraints": "UNIQUE NOT NULL"},
        {"name": "username", "type": "VARCHAR(255)", "constraints": null},
        {"name": "first_name", "type": "VARCHAR(255)", "constraints": "NOT NULL"},
        {"name": "last_name", "type": "VARCHAR(255)", "constraints": null},
        {"name": "language_code", "type": "VARCHAR(10)", "constraints": "DEFAULT 'ru'"},
        {"name": "is_banned", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "ban_reason", "type": "TEXT", "constraints": null},
        {"name": "banned_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "last_active_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_users_telegram_id", "idx_users_last_active"],
      "foreign_keys": []
    },
    {
      "name": "profiles",
      "description": "Расширенный профиль пользователя для знакомств",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "user_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES users(id)"},
        {"name": "display_name", "type": "VARCHAR(100)", "constraints": null},
        {"name": "date_of_birth", "type": "DATE", "constraints": "NOT NULL"},
        {"name": "gender", "type": "gender_enum", "constraints": "NOT NULL"},
        {"name": "bio", "type": "TEXT", "constraints": null},
        {"name": "height_cm", "type": "SMALLINT", "constraints": null},
        {"name": "interests", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "city", "type": "VARCHAR(100)", "constraints": null},
        {"name": "country_code", "type": "CHAR(2)", "constraints": null},
        {"name": "latitude", "type": "DECIMAL(9,6)", "constraints": "CHECK (latitude BETWEEN -90 AND 90)"},
        {"name": "longitude", "type": "DECIMAL(9,6)", "constraints": "CHECK (longitude BETWEEN -180 AND 180)"},
        {"name": "location_updated_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "looking_for", "type": "looking_for_enum", "constraints": "NOT NULL"},
        {"name": "age_range_min", "type": "SMALLINT", "constraints": "DEFAULT 18 CHECK (age_range_min >= 18)"},
        {"name": "age_range_max", "type": "SMALLINT", "constraints": "DEFAULT 100 CHECK (age_range_max <= 100)"},
        {"name": "distance_max_km", "type": "SMALLINT", "constraints": "DEFAULT 100 CHECK (distance_max_km BETWEEN 1 AND 500)"},
        {"name": "is_active", "type": "BOOLEAN", "constraints": "DEFAULT TRUE"},
        {"name": "is_verified", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "verified_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "profile_completion_pct", "type": "SMALLINT", "constraints": "DEFAULT 0"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_profiles_user_id", "idx_profiles_active_gender", "idx_profiles_city", "idx_profiles_location", "idx_profiles_dob", "idx_profiles_interests"],
      "foreign_keys": [{"column": "user_id", "references": "users(id)"}]
    },
    {
      "name": "preferences",
      "description": "Детальные предпочтения пользователя для тонкой настройки подбора",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "preferred_cities", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "preferred_countries", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "education_preference", "type": "VARCHAR(50)", "constraints": null},
        {"name": "occupation_preference", "type": "VARCHAR(50)", "constraints": null},
        {"name": "relationship_goals", "type": "relationship_goal_enum", "constraints": null},
        {"name": "height_min_cm", "type": "SMALLINT", "constraints": null},
        {"name": "height_max_cm", "type": "SMALLINT", "constraints": null},
        {"name": "deal_breakers", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "importance_weights", "type": "JSONB", "constraints": "DEFAULT '{\"age\": 0.2, \"distance\": 0.3, \"interests\": 0.5}'::jsonb"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_preferences_profile_id"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "photos",
      "description": "Метаданные фотографий профилей с AI-модерацией",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "s3_key", "type": "VARCHAR(500)", "constraints": "NOT NULL"},
        {"name": "s3_bucket", "type": "VARCHAR(100)", "constraints": "DEFAULT 'profile-photos'"},
        {"name": "thumbnail_s3_key", "type": "VARCHAR(500)", "constraints": null},
        {"name": "blurhash", "type": "VARCHAR(50)", "constraints": null},
        {"name": "is_primary", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "sort_order", "type": "SMALLINT", "constraints": "DEFAULT 0"},
        {"name": "file_size_bytes", "type": "INTEGER", "constraints": null},
        {"name": "mime_type", "type": "VARCHAR(50)", "constraints": "DEFAULT 'image/jpeg'"},
        {"name": "width", "type": "SMALLINT", "constraints": null},
        {"name": "height", "type": "SMALLINT", "constraints": null},
        {"name": "moderation_status", "type": "moderation_status_enum", "constraints": "DEFAULT 'pending'"},
        {"name": "moderated_by", "type": "UUID", "constraints": "REFERENCES users(id)"},
        {"name": "moderated_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "rejection_reason", "type": "TEXT", "constraints": null},
        {"name": "nsfw_score", "type": "DECIMAL(3,2)", "constraints": null},
        {"name": "face_detected", "type": "BOOLEAN", "constraints": null},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_photos_profile", "idx_photos_primary"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}, {"column": "moderated_by", "references": "users(id)"}]
    },
    {
      "name": "swipes",
      "description": "История действий пользователей (лайки/пропуски)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "swiper_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "swiped_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "action", "type": "swipe_action_enum", "constraints": "NOT NULL"},
        {"name": "source", "type": "VARCHAR(20)", "constraints": null},
        {"name": "time_spent_ms", "type": "INTEGER", "constraints": null},
        {"name": "context_data", "type": "JSONB", "constraints": "DEFAULT '{}'::jsonb"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_swipes_pair", "idx_swipes_swiped", "idx_swipes_created"],
      "foreign_keys": [
        {"column": "swiper_id", "references": "profiles(id)"},
        {"column": "swiped_id", "references": "profiles(id)"}
      ]
    },
    {
      "name": "matches",
      "description": "Взаимные лайки (мэтчи)",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile1_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "profile2_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "status", "type": "match_status_enum", "constraints": "DEFAULT 'active'"},
        {"name": "initiator_id", "type": "UUID", "constraints": "REFERENCES profiles(id)"},
        {"name": "message_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "last_message_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "last_message_preview", "type": "VARCHAR(100)", "constraints": null},
        {"name": "unmatched_by", "type": "UUID", "constraints": "REFERENCES profiles(id)"},
        {"name": "unmatched_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_matches_pair", "idx_matches_profile1", "idx_matches_profile2", "idx_matches_last_msg"],
      "foreign_keys": [
        {"column": "profile1_id", "references": "profiles(id)"},
        {"column": "profile2_id", "references": "profiles(id)"},
        {"column": "initiator_id", "references": "profiles(id)"},
        {"column": "unmatched_by", "references": "profiles(id)"}
      ]
    },
    {
      "name": "messages",
      "description": "Сообщения в чате между мэтчами",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "match_id", "type": "UUID", "constraints": "NOT NULL REFERENCES matches(id)"},
        {"name": "sender_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "content", "type": "TEXT", "constraints": null},
        {"name": "message_type", "type": "VARCHAR(20)", "constraints": "DEFAULT 'text'"},
        {"name": "media_urls", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "is_read", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "read_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "is_delivered", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "delivered_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "reply_to_id", "type": "UUID", "constraints": "REFERENCES messages(id)"},
        {"name": "is_edited", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "edited_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_messages_match", "idx_messages_unread"],
      "foreign_keys": [
        {"column": "match_id", "references": "matches(id)"},
        {"column": "sender_id", "references": "profiles(id)"},
        {"column": "reply_to_id", "references": "messages(id)"}
      ]
    },
    {
      "name": "reports",
      "description": "Жалобы пользователей на модерацию",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "reporter_profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "reported_profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "reason", "type": "report_reason_enum", "constraints": "NOT NULL"},
        {"name": "description", "type": "TEXT", "constraints": null},
        {"name": "evidence_urls", "type": "JSONB", "constraints": "DEFAULT '[]'::jsonb"},
        {"name": "message_id", "type": "UUID", "constraints": "REFERENCES messages(id)"},
        {"name": "status", "type": "report_status_enum", "constraints": "DEFAULT 'open'"},
        {"name": "reviewed_by", "type": "UUID", "constraints": "REFERENCES users(id)"},
        {"name": "reviewed_at", "type": "TIMESTAMPTZ", "constraints": null},
        {"name": "resolution_notes", "type": "TEXT", "constraints": null},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_reports_status", "idx_reports_reported"],
      "foreign_keys": [
        {"column": "reporter_profile_id", "references": "profiles(id)"},
        {"column": "reported_profile_id", "references": "profiles(id)"},
        {"column": "message_id", "references": "messages(id)"},
        {"column": "reviewed_by", "references": "users(id)"}
      ]
    },
    {
      "name": "blocks",
      "description": "Блокировки пользователей",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "blocker_profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "blocked_profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "reason", "type": "block_reason_enum", "constraints": "DEFAULT 'manual'"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_blocks_blocker", "idx_blocks_blocked"],
      "foreign_keys": [
        {"column": "blocker_profile_id", "references": "profiles(id)"},
        {"column": "blocked_profile_id", "references": "profiles(id)"}
      ]
    },
    {
      "name": "ratings_primary",
      "description": "Первичный рейтинг на основе данных анкеты",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "completeness_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (completeness_score BETWEEN 0 AND 1)"},
        {"name": "photo_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (photo_score BETWEEN 0 AND 1)"},
        {"name": "photo_count", "type": "SMALLINT", "constraints": "DEFAULT 0"},
        {"name": "preference_match_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (preference_match_score BETWEEN 0 AND 1)"},
        {"name": "verification_bonus", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (verification_bonus BETWEEN 0 AND 1)"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (total_score BETWEEN 0 AND 1)"},
        {"name": "version", "type": "INTEGER", "constraints": "DEFAULT 1"},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_primary_profile", "idx_ratings_primary_score"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "ratings_behavioral",
      "description": "Поведенческий рейтинг на основе активности",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "NOT NULL REFERENCES profiles(id)"},
        {"name": "like_received_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "pass_received_count", "type": "INTEGER", "constraints": "DEFAULT 0"},
        {"name": "like_count_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (like_count_score BETWEEN 0 AND 1)"},
        {"name": "like_pass_ratio_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (like_pass_ratio_score BETWEEN 0 AND 1)"},
        {"name": "match_rate_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (match_rate_score BETWEEN 0 AND 1)"},
        {"name": "conversation_initiation_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (conversation_initiation_score BETWEEN 0 AND 1)"},
        {"name": "response_rate_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (response_rate_score BETWEEN 0 AND 1)"},
        {"name": "activity_pattern_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (activity_pattern_score BETWEEN 0 AND 1)"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (total_score BETWEEN 0 AND 1)"},
        {"name": "period_start", "type": "DATE", "constraints": "NOT NULL"},
        {"name": "period_end", "type": "DATE", "constraints": "NOT NULL"},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_beh_profile_period"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "ratings_combined",
      "description": "Комбинированный рейтинг — интеграция всех факторов",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "profile_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES profiles(id)"},
        {"name": "primary_score", "type": "DECIMAL(5,4)", "constraints": "NOT NULL CHECK (primary_score BETWEEN 0 AND 1)"},
        {"name": "primary_weight", "type": "DECIMAL(3,2)", "constraints": "DEFAULT 0.40"},
        {"name": "behavioral_score", "type": "DECIMAL(5,4)", "constraints": "NOT NULL CHECK (behavioral_score BETWEEN 0 AND 1)"},
        {"name": "behavioral_weight", "type": "DECIMAL(3,2)", "constraints": "DEFAULT 0.50"},
        {"name": "referral_bonus", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (referral_bonus BETWEEN 0 AND 1)"},
        {"name": "referral_weight", "type": "DECIMAL(3,2)", "constraints": "DEFAULT 0.10"},
        {"name": "total_score", "type": "DECIMAL(5,4)", "constraints": "DEFAULT 0 CHECK (total_score BETWEEN 0 AND 1)"},
        {"name": "rank_position", "type": "INTEGER", "constraints": null},
        {"name": "percentile", "type": "DECIMAL(5,4)", "constraints": null},
        {"name": "tier", "type": "VARCHAR(10)", "constraints": null},
        {"name": "calculated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"}
      ],
      "indexes": ["idx_ratings_combined_profile", "idx_ratings_combined_score", "idx_ratings_combined_tier"],
      "foreign_keys": [{"column": "profile_id", "references": "profiles(id)"}]
    },
    {
      "name": "referrals",
      "description": "Реферальная программа — приглашения друзей",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "referrer_id", "type": "UUID", "constraints": "NOT NULL REFERENCES users(id)"},
        {"name": "referred_id", "type": "UUID", "constraints": "UNIQUE NOT NULL REFERENCES users(id)"},
        {"name": "referral_code", "type": "VARCHAR(50)", "constraints": "UNIQUE NOT NULL"},
        {"name": "bonus_earned", "type": "DECIMAL(10,2)", "constraints": "DEFAULT 0"},
        {"name": "referred_user_active", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "referred_user_premium", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "referred_profile_created", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "referred_first_match", "type": "BOOLEAN", "constraints": "DEFAULT FALSE"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "constraints": "DEFAULT NOW()"},
        {"name": "activated_at", "type": "TIMESTAMPTZ", "constraints": null}
      ],
      "indexes": ["idx_referrals_referrer", "idx_referrals_code"],
      "foreign_keys": [
        {"column": "referrer_id", "references": "users(id)"},
        {"column": "referred_id", "references": "users(id)"}
      ]
    },
    {
      "name": "sessions",
      "description": "Сессии пользователей для управления кэшированием анкет",
      "columns": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY DEFAULT gen_random_uuid()"},
        {"name": "user_id", "type": "UUID", "constraints": "NOT NULL REFERENCES users(id)"},
        {"name": "session_token", "type": "VARCHAR(255)", "constraints": "UNIQUE NOT NULL"},
        {"name": "redis_cache_key", "type": "VARCHAR(255)", "constraints": null},
        {"name": "cached_profiles_count", "type": "SMALLINT", "constraints": "DEFAULT 0"},
        {"name": "current_profile_index", "type": "SMALLINT", "constraints": "DEFAULT 0"},
