# ConnectMe environment variables — пример.
# Скопируйте в .env и заполните реальными значениями. Все REQUIRED-переменные
# обязательны: запуск compose без них падает с понятной ошибкой (см. ${VAR:?...}
# в docker-compose*.yml).

# === Telegram Bot ===
# REQUIRED — токен от @BotFather
TELEGRAM_BOT_TOKEN=REQUIRED_TELEGRAM_BOT_TOKEN

# === PostgreSQL ===
# REQUIRED — все три значения
POSTGRES_USER=REQUIRED_POSTGRES_USER
POSTGRES_PASSWORD=REQUIRED_POSTGRES_PASSWORD
POSTGRES_DB=REQUIRED_POSTGRES_DB
# Производное значение, использует POSTGRES_* выше (синхронизируйте вручную):
DATABASE_URL=postgresql+asyncpg://REQUIRED_POSTGRES_USER:REQUIRED_POSTGRES_PASSWORD@db:5432/REQUIRED_POSTGRES_DB

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Celery ===
# По умолчанию использует REDIS_URL. Для отдельной БД:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# === RabbitMQ ===
# REQUIRED — слабые дефолты guest/guest в compose запрещены
RABBITMQ_USER=REQUIRED_RABBITMQ_USER
RABBITMQ_PASSWORD=REQUIRED_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://REQUIRED_RABBITMQ_USER:REQUIRED_RABBITMQ_PASSWORD@rabbitmq:5672//

# === MinIO (S3) ===
# REQUIRED — ключи доступа
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REQUIRED_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REQUIRED_MINIO_SECRET_KEY
MINIO_BUCKET=profile-photos
MINIO_USE_SSL=false
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# === Bot → Backend ===
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000

# === Monitoring (Grafana) ===
# REQUIRED для prod overlay
GRAFANA_ADMIN_USER=REQUIRED_GRAFANA_ADMIN_USER
GRAFANA_ADMIN_PASSWORD=REQUIRED_GRAFANA_ADMIN_PASSWORD

# === Application ===
LOG_LEVEL=INFO
DEBUG=false

# === Прокси для Telegram API (опционально, обычно не нужен) ===
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
