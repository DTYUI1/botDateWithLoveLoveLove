# ConnectMe environment variables (пример)
# Скопируйте в .env и заполните реальными значениями.

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# === PostgreSQL ===
POSTGRES_USER=connectme_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=connectme_db
DATABASE_URL=postgresql+asyncpg://connectme_user:change_me_strong_password@db:5432/connectme_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Celery ===
# По умолчанию Celery использует REDIS_URL; при необходимости укажите явно:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# === RabbitMQ ===
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# === MinIO (S3) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=profile-photos
MINIO_USE_SSL=false
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# === Bot → Backend ===
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000

# === Monitoring (Grafana) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# === Application ===
LOG_LEVEL=INFO
DEBUG=false

# === Прокси для Telegram API (опционально) ===
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
